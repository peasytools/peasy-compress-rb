# peasy-compress-rb — ZIP, TAR, gzip compression (Ruby)
# Theme: Tokyo Night
# Generated for AgentGIF demo collection

Output demo.gif
Set Shell "zsh"
Set Theme "TokyoNight"
Set Width 800
Set Height 500
Set FontSize 14
Set Padding 20
Set TypingSpeed 50ms

# Show package info
Type "# peasy-compress-rb — ZIP, TAR, gzip compression for Ruby"
Enter
Type "# peasytools.com"
Enter
Sleep 500ms

# Run the demo
Type "ruby -I lib examples/demo.rb"
Enter
Sleep 5s
